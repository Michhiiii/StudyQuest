@startuml
class User {
  - userID
  - name
  - email
  - passwordHash
  - level
  - xp
  - badges
  + login()
  + logout()
  + updateProfile()
  + resetPassword()
}

class Admin {
  - adminID
  - name
  - email
  + manageUser()
  + manageQuest()
  + configureXP()
}

class QuestController {
  + startQuest()
  + completeQuest()
  + getActiveQuests()
}

class Quest {
  - questID
  - title
  - description
  - xpReward
  - status
  + start()
  + complete()
}

class Progress {
  - xpTotal
  - level
  - streaks
  - completedQuests
  + updateXP()
  + checkLevelUp()
  + trackSession()
}

class GamificationEngine {
  + calculateXP()
  + checkLevelUp()
  + awardBadge()
}

class GradeController {
  + saveGrade()
  + calculateAverage()
  + importExportGrades()
}

class Course {
  - courseID
  - title
  - ects
  - grade
  + addGrade()
  + updateGrade()
}

class LeaderboardService {
  + calculateRanking()
  + showLeaderboard()
}

class NotificationService {
  + sendNotification()
  + saveSettings()
}

class BadgeService {
  + awardBadge()
}

class UserController {
  + updateUserStatus()
}

class QuestRepository {
  + saveQuest()
  + deleteQuest()
  + getQuestByID()
}

class UserRepository {
  + saveUser()
  + findUserByID()
  + updatePassword()
}

' Beziehungen
User --> QuestController
User --> GradeController
User --> NotificationService
User --> Progress
User --> LeaderboardService

QuestController --> QuestRepository
QuestController --> GamificationEngine
GamificationEngine --> Progress
Progress --> BadgeService

GradeController --> Course
Admin --> QuestController
Admin --> UserController
Admin --> GamificationEngine
UserController --> UserRepository
@enduml
